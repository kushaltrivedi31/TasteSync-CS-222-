# Optional local settings. Copy to .env (which is gitignored) and fill in what you need.
# Never commit .env or real keys.

# Port for the Express API server. The Vite dev server proxies /api here.
PORT=3001

# Port for the Vite dev/preview server.
CLIENT_PORT=5173

# --- Google restaurant search (optional; see "Google Maps setup" in README.md) ---

# SERVER-ONLY key for Places API (New) Text Search. Read by Express, never sent to
# the browser. Do NOT rename it with a VITE_ prefix.
GOOGLE_PLACES_API_KEY=

# PUBLIC browser key for the Maps JavaScript API (map and markers). Visible in the
# browser by design: restrict it to the Maps JavaScript API and your site's referrers.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID for Advanced Markers. Leave blank to use Google's DEMO_MAP_ID (testing only).
VITE_GOOGLE_MAPS_MAP_ID=
